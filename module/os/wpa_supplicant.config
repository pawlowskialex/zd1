# wpa_supplicant 2.11 build config (its .config): WPA2-PSK on the module's Wi-Fi core and nothing else. sulu_wlan is
# a mac80211 driver on a 2.6.24 kernel without nl80211 for it: Wireless Extensions only. Internal crypto (no OpenSSL);
# no EAP, no WPS, no SAE (WEXT can't do SAE anyway). Roaming on: on a scan's results it moves to a stronger access
# point of the joined network (zd1-net's Roam asks for scans while the signal is weak). nix/module/wpa_supplicant.nix
# builds with it.
CONFIG_DRIVER_WEXT=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_NO_RANDOM_POOL=y
CONFIG_IEEE80211W=y
CONFIG_NO_CONFIG_WRITE=y
CFLAGS += -Os
