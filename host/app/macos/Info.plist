<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- zd1.app's (nix/app.nix, nix/app-macos.nix): @VERSION@ the crate's, @BUILD@ the commit's. macOS asks the person
     once to let it reach the local network, with NSLocalNetworkUsageDescription's words. -->
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>zd1-app</string>
  <key>CFBundleIdentifier</key><string>io.github.pawlowskialex.zd1</string>
  <key>CFBundleName</key><string>zd1</string>
  <key>CFBundleDisplayName</key><string>zd1 · Zeppelin Air</string>
  <key>CFBundleIconFile</key><string>zd1</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@BUILD@</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSLocalNetworkUsageDescription</key>
  <string>zd1 reaches your Zeppelin Air at its address on this network: its settings, its updates.</string>
</dict>
</plist>
